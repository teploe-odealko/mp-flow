{
  "name": "mp-flow",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Open-source управленческий учет для продавцов маркетплейсов",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teploe-odealko/mp-flow.git"
  },
  "bugs": {
    "url": "https://github.com/teploe-odealko/mp-flow/issues"
  },
  "homepage": "https://github.com/teploe-odealko/mp-flow",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/backend/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.json --noEmit && vite build --config vite.backend.config.ts && cp src/infra/db/schema.sql dist/server/schema.sql",
    "build:client": "vite build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:postgres": "RUN_POSTGRES_TESTS=1 vitest run tests/integration/postgres-runtime.test.ts",
    "test:scenarios": "vitest run tests/scenarios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@hono/node-server": "^2.0.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "^5.100.11",
    "better-auth": "1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.26",
    "lucide-react": "^1.16.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
