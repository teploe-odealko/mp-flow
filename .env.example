# MPFlow local/production environment template.
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3004

# Persistence
ACCOUNTING_PERSISTENCE=postgres
DATABASE_URL=postgresql://mpflow:mpflow_local@127.0.0.1:54322/mpflow

# Symmetric key for encrypted marketplace credentials.
# Production value must be long, random and backed up. Losing it makes stored channel credentials unreadable.
ACCOUNTING_ENCRYPTION_KEY=mpflow-local-dev-stable-key-change-in-production

# Auth
AUTH_REQUIRED=true
PUBLIC_APP_URL=http://127.0.0.1:3004
CORS_ORIGIN=http://127.0.0.1:5174
ACCOUNTING_AUTH_BOOTSTRAP_EMAILS=owner@example.com
ACCOUNTING_AUTH_PUBLIC_SIGNUP=true
ACCOUNTING_SAAS_WORKSPACES_ENABLED=true

# Email verification
ACCOUNTING_EMAIL_PROVIDER=smtp
ACCOUNTING_AUTH_EMAIL_FROM="MPFlow <noreply@example.com>"
ACCOUNTING_AUTH_SMTP_HOST=smtp.example.com
ACCOUNTING_AUTH_SMTP_PORT=465
ACCOUNTING_AUTH_SMTP_SECURE=true
ACCOUNTING_AUTH_SMTP_IGNORE_TLS=false
ACCOUNTING_AUTH_SMTP_USER=noreply@example.com
ACCOUNTING_AUTH_SMTP_PASS=

# Error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Prometheus /metrics. Required in production.
METRICS_TOKEN=local-metrics-token-change-in-production

# Optional integration defaults for local smoke tests.
# OZON_CLIENT_ID=
# OZON_API_KEY=
